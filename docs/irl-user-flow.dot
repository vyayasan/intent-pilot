digraph irlflow {
  graph [rankdir=LR, bgcolor="#fffaf0", pad="0.28", nodesep="0.32", ranksep="0.5", splines=polyline, fontname="Inter", labelloc=t, label="INTENT PILOT  /  HOW IT WORKS IN REAL LIFE", fontsize=22, fontcolor="#183d32"];
  node [shape=box, style="rounded,filled", color="#d8e2d8", fillcolor="#fffdf8", fontname="Inter", fontsize=11, fontcolor="#1d2a25", margin="0.16,0.12", penwidth=1.3];
  edge [color="#35594b", penwidth=1.5, arrowsize=0.72, fontname="Inter", fontsize=9, fontcolor="#52675d"];
  onboard [label="1 · SETUP (person, once)\nFinance lead connects Airwallex\nSets policy: reserve floor · forecast\ncategories · caps", fillcolor="#f3ead8", color="#d7c8a8", penwidth=1.6];
  request [label="2 · PURCHASE REQUEST (person)\nOps pastes the vendor's real terms\n\"$100/mo or $984/yr, 30 days notice\"", fillcolor="#f3ead8", color="#d7c8a8"];
  extract [label="3 · TERMS EXTRACTION (agent)\nModel reads terms under the gate\nInjection treated as data\nUnsure? It asks a person", fillcolor="#f7eee5", color="#d9b18c"];
  decide [label="4 · DECISION (deterministic code)\nAnnual vs monthly against the\nforecast and the floor, with reasons\nand a reconsider date", fillcolor="#dcebe0", color="#789b82"];
  approve [label="5 · INTENT APPROVAL (person)\nOne click, HMAC-bound, expiring\nCadence · cap · currency · categories\nor reject with a reason", fillcolor="#f3ead8", color="#d7c8a8", penwidth=1.6];
  issue [label="6 · CARD ISSUED (agent on Airwallex)\nVirtual card, controls mirror the\napproved intent exactly\nApproval re-verified at issue", fillcolor="#dcebe0", color="#789b82"];
  auth [label="7 · LIVE AUTHORIZATION (card rail)\nVendor charges at renewal\nIn-policy clears; anything else\ndeclines with the rule named", fillcolor="#dcebe0", color="#789b82"];
  settle [label="8 · SETTLEMENT + AUDIT (rail + code)\nClearing webhooks reconcile\nEvery step in the hash-chained log\nReconsider date re-prompts", fillcolor="#fae9e4", color="#d7897c"];
  onboard -> request -> extract -> decide -> approve -> issue -> auth -> settle;
  extract -> approve [style=dashed, constraint=false, label="escalate: a person decides"];
}
